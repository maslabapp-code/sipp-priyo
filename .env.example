# Salin file ini menjadi ".env" lalu isi sesuai komputer/server masing-masing.
#   Windows (CMD):  copy .env.example .env
# File .env TIDAK ikut ke GitHub (sudah diabaikan oleh .gitignore).

# Ganti PASSWORD_POSTGRES dengan password user postgres yang dibuat saat instal PostgreSQL.
DATABASE_URL="postgresql://postgres:PASSWORD_POSTGRES@localhost:5432/mtp_dev?schema=public"

# Opsional: isi kalau fitur Backup Database error "gagal menjalankan pg_dump"
# (sesuaikan versi PostgreSQL-nya).
# PG_DUMP_PATH="C:\Program Files\PostgreSQL\16\bin\pg_dump.exe"

# ── Login admin (WAJIB) ──
# Satu akun admin untuk semua pengguna. Pakai huruf dan angka saja (hindari # $ " ' spasi).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="GANTI_PASSWORD_KUAT"
# Kunci rahasia penanda sesi login, minimal 16 karakter acak. Buat dengan:
#   Linux/VPS:  openssl rand -hex 32
#   Windows:    powershell -Command "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"
AUTH_SECRET="GANTI_DENGAN_TEKS_ACAK_PANJANG"
